# Resend (https://resend.com) — required for tour/booking/contact confirmation emails.
# Get a free API key from the Resend dashboard after signing up.
RESEND_API_KEY=

# The "From" address emails are sent from.
# - If you haven't verified a custom domain in Resend yet, leave this as the
#   default sandbox sender: "Aurura Event Center <onboarding@resend.dev>"
#   (Resend's sandbox domain can only deliver to the email address you signed
#   up to Resend with — fine for testing, not for real customers.)
# - Once you verify your own domain in Resend, set this to something like:
#   EMAIL_FROM="Aurura Event Center <events@aururaeventcenter.com>"
EMAIL_FROM="Aurura Event Center <onboarding@resend.dev>"

# Where new tour bookings, deposits, and contact-form leads get notified.
VENUE_NOTIFY_EMAIL=events@aururaeventcenter.com
